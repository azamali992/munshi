# Copy to .env — the app reads these at startup (docker compose loads .env automatically;
# for a bare `uvicorn` run, `export $(cat .env | xargs)` or use your shell's dotenv).

# Which model runs the agents.
#   stub  -> deterministic, keyword-driven, no key needed (demo, tests, CI)
#   groq  -> real LLM via Groq; requires GROQ_API_KEY
LLM_PROVIDER=stub

# Free at https://console.groq.com -> API Keys. Used for LLM_PROVIDER=groq and for
# voice notes (POST /api/voice -> whisper-large-v3). Never commit this file.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Sign-in PINs, one per role. Change these before anyone else can reach the app.
OWNER_PIN=1111
CLERK_PIN=2222
DRIVER_PIN=3333

# Signs session tokens. Any long random string: `python3 -c "import secrets;print(secrets.token_hex(32))"`
MUNSHI_SECRET=change-me

# Where the system of record lives (SQLite). Docker compose mounts ./data here.
MUNSHI_DB=munshi.db

# MLflow tracing of every agent turn (1 to enable). Local file store under ./mlruns.
MUNSHI_TRACING=0
