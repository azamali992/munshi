# Copy to .env — docker compose loads it automatically; for a bare run, `export $(grep -v '^#' .env | xargs)`.

# ---- mode -------------------------------------------------------------
# development (default): sign-up open, API docs at /api/docs, a random per-start secret is fine.
# production: MUNSHI_SECRET required, sign-up closed unless MUNSHI_SIGNUP=1, HSTS on, /api/docs off.
MUNSHI_ENV=development

# Signs public invoice links. Required in production. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
MUNSHI_SECRET=

# Where everything lives: registry.db, tenants/<business>.db, backups/. Docker mounts ./data here.
MUNSHI_DATA_DIR=data

# Seed the Sultan Traders demo business (4 demo users) on first start. Set 0 on a customer's server.
MUNSHI_DEMO=1
# Allow "Create your business" from the sign-in screen (1/0). Defaults: open in development, closed in production.
MUNSHI_SIGNUP=
# Public base URL used in invoice links sent to customers (e.g. https://munshi.example.pk). Defaults to the request host.
MUNSHI_PUBLIC_URL=

# ---- language model ---------------------------------------------------
# stub  -> deterministic, keyword-driven, no key needed (demo, tests, CI)
# groq  -> real LLM via Groq; needs GROQ_API_KEY. Free key: https://console.groq.com -> API Keys
# With groq the chat is a hybrid: the offline rules answer first, and the model is only called
# when they don't understand a message; code checks every model action before it becomes a card.
LLM_PROVIDER=stub
GROQ_API_KEY=
# gemini -> Google Gemini; needs GOOGLE_API_KEY from https://aistudio.google.com/apikey
#           and LLM_MODEL=gemini-flash-latest (or gemini-3.5-flash-lite: faster, cheaper)
GOOGLE_API_KEY=
# openai/gpt-oss-120b (better) or openai/gpt-oss-20b (faster, cheaper). llama-3.3-70b-versatile
# needs an enterprise Groq plan and returns "model not found" on a standard key.
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
# low | medium | high (reasoning models); low keeps replies quick
LLM_REASONING_EFFORT=low
# Voice notes (mic button) use Groq Whisper with the same key. VOICE_LANG=ur forces Urdu transcription.
VOICE_LANG=auto

# ---- customer messages (WhatsApp Business Cloud API) -------------------
# Both set -> delivery codes, invoices, receipts and reminders are sent automatically.
# Unset   -> they queue in the app's Messages screen with one-tap wa.me links.
# Get them at https://developers.facebook.com/apps -> WhatsApp -> API setup (permanent token via a system user).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Optional: an approved message template with one {{1}} body parameter. Meta delivers business-initiated
# messages outside a 24-hour customer window only as templates, so set this once your template is approved.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Alternative channel: POST {"to","text"} to any URL (an n8n flow, an SMS-gateway app on a spare phone, a Twilio wrapper).
# Used only when the WhatsApp variables above are not set.
MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=

# ---- observability -----------------------------------------------------
# 1 -> every agent turn is traced to MLflow (file store under MLFLOW_TRACKING_DIR)
MUNSHI_TRACING=0
# in-process scheduler: outbox delivery, the owner's evening digest, nightly backups (1/0)
MUNSHI_SCHEDULER=1
# when the scheduler writes a backup of every business file to $MUNSHI_DATA_DIR/backups (kept 14 days)
MUNSHI_BACKUP_TIME=02:30
LOG_LEVEL=INFO
